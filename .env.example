# Copy to .env.local and fill in.
# The name that unlocks owner mode when typed in the guestbook gate.
OWNER_NAME=0zong
# Create both lines with:  npm run hash-password -- "your password"
OWNER_PASSWORD_HASH=
SESSION_SECRET=
# Optional: where the JSON store lives (default: ./data/db.json)
# ROOM_DB_FILE=
# Optional: TMDB key for the owner's movie search (v3 API key or v4 read access token). Server-only, never sent to the browser.
# Without it, search is off and movies are entered by hand.
TMDB_API_KEY=
